/**
 * Write custom configuration values to the imported modules.
 */
GPIO1.$name                              = "ENCODER_RIGHT_A";
GPIO1.associatedPins[0].$name            = "ENC_R_A";
GPIO1.associatedPins[0].direction        = "INPUT";
GPIO1.associatedPins[0].internalResistor = "PULL_UP";
GPIO1.associatedPins[0].interruptEn      = true;
GPIO1.associatedPins[0].polarity         = "RISE_FALL";
GPIO1.associatedPins[0].pin.$assign      = "PB8";

const Board = scripting.addModule("/ti/driverlib/Board", {}, false);

GPIO2.$name                              = "ENCODER_RIGHT_B";
GPIO2.associatedPins[0].$name            = "ENC_R_B";
GPIO2.associatedPins[0].direction        = "INPUT";
GPIO2.associatedPins[0].internalResistor = "PULL_UP";
GPIO2.associatedPins[0].interruptEn      = true;
GPIO2.associatedPins[0].polarity         = "RISE_FALL";
GPIO2.associatedPins[0].pin.$assign      = "PB9";

GPIO3.$name                         = "GPIO_MOTOR_DIR";
GPIO3.associatedPins.create(5);
GPIO3.associatedPins[0].$name       = "STBY";
GPIO3.associatedPins[0].pin.$assign = "PA12";
