GPIO3.associatedPins[1].pin.$assign = "PA13";
GPIO3.associatedPins[2].$name       = "AIN2";
GPIO3.associatedPins[2].pin.$assign = "PB4";
GPIO3.associatedPins[3].$name       = "BIN1";
